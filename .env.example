NODE_ENV=development
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://devblueprint:devblueprint@localhost:5432/devblueprint?schema=public

AUTH_SECRET=changeme_in_production_32_chars_min
AUTH_TRUST_HOST=true

# Storage (MinIO dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=devblueprint
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Mail (Mailpit dev)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="DevBlueprint <no-reply@localhost>"

# AI Analysis (Gemini)
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=ใส่คีย์ของคุณในไฟล์ .env เท่านั้น

# Limits
MAX_UPLOAD_MB=20
